# Chat model (OpenAI-compatible)
# 当前项目已选提供商示例：火山方舟 / doubao-1-5-lite-32k-250115
# 真实密钥只应写入本机 `.env`，不要提交到仓库
CHAT_API_KEY=replace-me
CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CHAT_MODEL=doubao-1-5-lite-32k-250115
CHAT_TIMEOUT_SECONDS=30
CHAT_TEMPERATURE=0

# Local embedding model
EMBEDDING_MODEL_NAME=replace-me
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_SEQ_LENGTH=

# W-S RAG 评测问题生成模型
WS_RAG_QUESTION_GENERATOR_API_KEY=replace-me
WS_RAG_QUESTION_GENERATOR_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
WS_RAG_QUESTION_GENERATOR_MODEL=deepseek-v4-pro-260425

# W-S RAG 评测 Judge 模型
WS_RAG_JUDGE_API_KEY=replace-me
WS_RAG_JUDGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
WS_RAG_JUDGE_MODEL=doubao-seed-2-1-pro-260628

# W-S RAG 问题数量与重试（默认每类每文档 1 条，串行并发 1，额外重试 1 次）
WS_RAG_FREQUENT_QUESTIONS_PER_DOCUMENT=1
WS_RAG_BOUNDARY_QUESTIONS_PER_DOCUMENT=1
WS_RAG_DIVERSITY_QUESTIONS_PER_DOCUMENT=1
WS_RAG_MODEL_MAX_RETRIES=1
WS_RAG_MODEL_CONCURRENCY=1

# Conversation persistence
CONVERSATION_DB_PATH=var/conversations.db
CONVERSATION_CONTEXT_WINDOW_TURNS=4
CONVERSATION_SUMMARY_TRIGGER_TURNS=6
