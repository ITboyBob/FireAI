# Chat model (OpenAI-compatible)
# 当前项目已选提供商示例：火山方舟 / doubao-1-5-lite-32k-250115
# 真实密钥只应写入本机 `.env`，不要提交到仓库
CHAT_API_KEY=replace-me
CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CHAT_MODEL=doubao-1-5-lite-32k-250115
CHAT_TIMEOUT_SECONDS=30
CHAT_TEMPERATURE=0

# Local embedding model
EMBEDDING_MODEL_NAME=replace-me
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_SEQ_LENGTH=

# Conversation persistence
CONVERSATION_DB_PATH=var/conversations.db
CONVERSATION_CONTEXT_WINDOW_TURNS=4
CONVERSATION_SUMMARY_TRIGGER_TURNS=6
